---
import { Image } from 'astro:assets';
import type { Category } from '../data/catalog';
import type { Locale } from '../i18n/ui';

interface Props {
  category: Category;
  locale: Locale;
  href: string;
}

const { category, locale, href } = Astro.props;
---

<a class="category" href={href}>
  <span class="category-photo">
    <Image
      src={category.image}
      alt={category.alt[locale]}
      widths={[320, 480]}
      sizes="(min-width: 1100px) 16vw, (min-width: 700px) 24vw, 45vw"
      format="webp"
      quality={75}
      loading="lazy"
    />
  </span>
  <span class="category-label">{category.label[locale]}</span>
</a>
