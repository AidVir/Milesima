---
import {
  drinkAlt,
  placeLine,
  producerName,
  showProducer,
  type Drink,
} from '../data/catalog';
import { localePath, type Locale } from '../i18n/ui';
import DrinkImage from './DrinkImage.astro';

interface Props {
  product: Drink;
  locale: Locale;
  heading?: 'h2' | 'h3';
  showProducerLine?: boolean;
}

const {
  product,
  locale,
  heading = 'h3',
  showProducerLine = false,
} = Astro.props;
const Heading = heading;
const href = localePath(locale, `/portfolio/product/${product.slug}`);
---

<a class="product" href={href}>
  <span class="product-media">
    <DrinkImage
      file={product.image}
      alt={drinkAlt(product, locale)}
      fallback="MILESIMA"
      widths={[240, 480]}
      sizes="(min-width: 1100px) 18vw, (min-width: 700px) 30vw, 45vw"
    />
  </span>
  <Heading class="product-name">{product.name}</Heading>
  <p class="product-meta">{placeLine(product, locale)}</p>
  {showProducerLine && showProducer(product) && (
    <p class="product-producer">{producerName(product)}</p>
  )}
</a>
